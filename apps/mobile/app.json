{
  "expo": {
    "scheme": "wakaboard",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "plugins": [
      "expo-router",
      [
        "@hot-updater/react-native",
        {
          "channel": "production"
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-localization",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/withAndroidImageDecoders"
    ],
    "name": "WakaBoard",
    "slug": "wakaboard",
    "version": "1.0.0",
    "android": {
      "package": "com.kompyler.wakaboard",
      "versionCode": 1,
      "icon": "./assets/icons/android-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-foreground.png",
        "monochromeImage": "./assets/icons/android-monochrome.png",
        "backgroundColor": "#0A382F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kompyler.wakaboard",
      "buildNumber": "1",
      "icon": "./assets/icons/WakaBoard.icon"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ebf1743-5056-4fbf-bb73-435469ab5b89"
      }
    },
    "owner": "wakaboard"
  }
}
