{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wakaboard-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wakaboard-auth",
      "migrations_dir": "migrations"
    }
  ]
}
